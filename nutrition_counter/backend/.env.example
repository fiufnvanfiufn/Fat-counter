# Copy this file to .env, then set the key locally.
# Classroom exception: the owner explicitly chose to include backend/.env in Git.
# Anyone with repository access can use that key and its quota. No real key is supplied here.
# Create a key: https://aistudio.google.com/api-keys
# Use a project on the Free tier without billing to avoid paid API usage.
# Regional availability and quotas: https://aistudio.google.com/docs/available-regions
# Free-tier prompts may be used by Google to improve products; do not send secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
